{
    "swagger": "2.0",
    "info": {
        "description": "REST API for Papiton Express Tracking Service (Milestone 1)",
        "title": "Papiton Express - Tracking Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8086",
    "basePath": "/",
    "paths": {
        "/trackings": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "trackings"
                ],
                "summary": "Initialize tracking for an order",
                "parameters": [
                    {
                        "description": "Create Tracking Payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateTrackingRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.Tracking"
                        }
                    }
                }
            }
        },
        "/trackings/search": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "trackings"
                ],
                "summary": "Search tracking by tracking number",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tracking Number",
                        "name": "q",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Tracking"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/trackings/{num}/events": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "trackings"
                ],
                "summary": "Add a new tracking event (milestone) and update current status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tracking Number",
                        "name": "num",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Event Payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.AddEventRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Tracking"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.AddEventRequest": {
            "type": "object",
            "required": [
                "description",
                "status"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "location": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "dto.CreateTrackingRequest": {
            "type": "object",
            "required": [
                "initialStatus",
                "orderId",
                "trackingNumber"
            ],
            "properties": {
                "initialStatus": {
                    "type": "string"
                },
                "orderId": {
                    "type": "string"
                },
                "trackingNumber": {
                    "type": "string"
                }
            }
        },
        "models.Tracking": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "currentStatus": {
                    "type": "string"
                },
                "events": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.TrackingEvent"
                    }
                },
                "id": {
                    "type": "string"
                },
                "lastUpdated": {
                    "type": "string"
                },
                "orderId": {
                    "type": "string"
                },
                "trackingNumber": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "models.TrackingEvent": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "location": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "trackingId": {
                    "type": "string"
                }
            }
        }
    }
}